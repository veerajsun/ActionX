# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Storage ---
# All uploaded/generated media is written here (never into src/, app/, or public/).
TEMP_DIR=./tmp

# --- File size limits (megabytes) ---
MAX_VIDEO_FILE_SIZE_MB=500
MAX_IMAGE_FILE_SIZE_MB=20

# --- Retention (minutes) ---
# How long a generated file stays downloadable before the cleanup sweep deletes it.
VIDEO_FILE_RETENTION_MINUTES=30
IMAGE_FILE_RETENTION_MINUTES=15
# How long a finished/failed job record stays queryable via GET /api/jobs/:jobId.
JOB_RETENTION_MINUTES=60

# --- Rate limiting ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- External binaries ---
# Override only if the binary isn't on PATH (e.g. a full path on Windows).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
